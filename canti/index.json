python3 -c '
import os, json
items = []
for f in sorted(os.listdir("canti")):
    if f.endswith(".json") and f != "index.json":
        with open(os.path.join("canti", f), encoding="utf-8") as fp:
            d = json.load(fp)
            slug = d.get("id") or f[:-5]
            items.append({
                "slug": slug,
                "title": d.get("title", slug),
                "author": d.get("sub") or d.get("author", ""),
                "categories": d.get("categories", ["Canti vari"]),
                "file": f
            })
with open("canti/index.json", "w", encoding="utf-8") as out:
    json.dump(items, out, ensure_ascii=False, indent=2)
print(f"Generato index.json con {len(items)} canti!")
'
